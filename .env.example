# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB
DYNAMODB_TABLE=ticket-inventory-service-dev
DYNAMODB_ENDPOINT=http://localhost:8000

# SQS
SQS_QUEUE_URL=http://localhost:9324/queue/ticket-updates

# Environment
NODE_ENV=development
LOG_LEVEL=debug
